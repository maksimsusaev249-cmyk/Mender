# GEMINI_API_KEY: Required if Gemini AI features are used on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed Mender app (e.g. https://mender.pages.dev).
APP_URL="MY_APP_URL"

# =========================================================================
# Server-side Firebase Custom Auth (REQUIRED for /api/auth/* on Cloudflare Pages & Vite)
# Never expose these values in VITE_* client variables!
# Option A: Full Service Account JSON string (or Base64 encoded JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B: Individual credentials
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_PROJECT_ID="optical-quill-dcf5x"
FIREBASE_DATABASE_ID="ai-studio-mendermessenger-3a629084-b705-4446-a866-39cb727e7017"

# Optional HMAC secret for stateless password recovery tokens
AUTH_CHALLENGE_SECRET=""

# =========================================================================
# WebRTC TURN Credentials (REQUIRED for stable calls across CGNAT / Kazakhstan without VPN)
# Option A: Cloudflare Calls Realtime TURN (recommended)
CF_TURN_TOKEN_ID=""
CF_TURN_API_TOKEN=""
# Option B: Self-hosted coturn HMAC REST secret
TURN_URLS=""
TURN_SECRET=""
# Option C: Static TURN credentials
TURN_USERNAME=""
TURN_CREDENTIAL=""
