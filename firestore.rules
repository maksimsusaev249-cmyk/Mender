rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. GLOBAL PRIMITIVES & HARDENED HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && isValidId(request.auth.uid);
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || (
          'firebase' in request.auth.token
          && 'sign_in_provider' in request.auth.token.firebase
          && request.auth.token.firebase.sign_in_provider in ['phone', 'custom']
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid));
    }

    function isChatAdmin(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
        || (
          isChatMember(chatId)
          && get(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
        );
    }

    // =========================================================================
    // 2. ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================

    function isValidUserPublic(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'username', 'avatarUrl', 'bio', 'status',
        'privacyLastSeen', 'privacyPhoto', 'privacyCalls',
        'followersCount', 'followingCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'username', 'avatarUrl', 'bio', 'status',
        'privacyLastSeen', 'privacyPhoto', 'privacyCalls',
        'followersCount', 'followingCount', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isOwner(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.username is string && data.username.size() >= 3 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9_]+$')
      && data.avatarUrl is string && data.avatarUrl.size() <= 2000
      && data.bio is string && data.bio.size() <= 500
      && data.status is string && data.status.size() <= 20 && data.status in ['online', 'offline', 'busy']
      && data.privacyLastSeen is string && data.privacyLastSeen.size() <= 20 && data.privacyLastSeen in ['everyone', 'contacts', 'nobody']
      && data.privacyPhoto is string && data.privacyPhoto.size() <= 20 && data.privacyPhoto in ['everyone', 'contacts', 'nobody']
      && data.privacyCalls is string && data.privacyCalls.size() <= 20 && data.privacyCalls in ['everyone', 'contacts', 'nobody']
      && data.followersCount is int && data.followersCount >= 0
      && data.followingCount is int && data.followingCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll([
        'uid', 'email', 'phone', 'pinHash', 'pinSalt',
        'darkMode', 'notificationsEnabled', 'soundEnabled', 'twoFactorEnabled',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'phone', 'pinHash', 'pinSalt',
        'passwordHash', 'passwordSalt',
        'darkMode', 'notificationsEnabled', 'soundEnabled', 'twoFactorEnabled',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isOwner(data.uid)
      && data.email is string && data.email.size() <= 254
      && data.phone is string && data.phone.size() <= 32
      && data.pinHash is string && data.pinHash.size() <= 128
      && data.pinSalt is string && data.pinSalt.size() <= 64
      && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128))
      && (!('passwordSalt' in data) || (data.passwordSalt is string && data.passwordSalt.size() <= 64))
      && data.darkMode is bool
      && data.notificationsEnabled is bool
      && data.soundEnabled is bool
      && data.twoFactorEnabled is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserBlock(data) {
      return data.keys().hasAll(['blockerId', 'blockedUserId', 'reason', 'createdAt'])
      && data.keys().hasOnly(['blockerId', 'blockedUserId', 'reason', 'createdAt'])
      && isValidId(data.blockerId)
      && isOwner(data.blockerId)
      && isValidId(data.blockedUserId)
      && data.reason is string && data.reason.size() <= 200
      && data.createdAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['subscriberId', 'targetId', 'targetType', 'createdAt'])
      && data.keys().hasOnly(['subscriberId', 'targetId', 'targetType', 'createdAt'])
      && isValidId(data.subscriberId)
      && isOwner(data.subscriberId)
      && isValidId(data.targetId)
      && data.targetType is string && data.targetType.size() <= 20 && data.targetType in ['user', 'channel']
      && data.createdAt is timestamp;
    }

    function isValidWallpaperConfig(data) {
      return data.keys().hasAll([
        'scopeId', 'userId', 'wallpaperId', 'sourceType', 'imageUrl',
        'backgroundColor', 'dimming', 'brightness', 'blur',
        'scale', 'posX', 'posY', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'scopeId', 'userId', 'wallpaperId', 'sourceType', 'imageUrl',
        'backgroundColor', 'dimming', 'brightness', 'blur',
        'scale', 'posX', 'posY', 'updatedAt'
      ])
      && isValidId(data.scopeId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && isValidId(data.wallpaperId)
      && data.sourceType is string && data.sourceType.size() <= 20 && data.sourceType in ['builtin', 'custom', 'color']
      && data.imageUrl is string && data.imageUrl.size() <= 800000
      && data.backgroundColor is string && data.backgroundColor.size() <= 32
      && data.dimming is int && data.dimming >= 0 && data.dimming <= 90
      && data.brightness is int && data.brightness >= 50 && data.brightness <= 150
      && data.blur is int && data.blur >= 0 && data.blur <= 30
      && data.scale is int && data.scale >= 100 && data.scale <= 300
      && data.posX is int && data.posX >= -100 && data.posX <= 100
      && data.posY is int && data.posY >= -100 && data.posY <= 100
      && data.updatedAt is timestamp;
    }

    function isValidCustomWallpaper(data) {
      return data.keys().hasAll([
        'wallpaperId', 'userId', 'name', 'imageUrl',
        'storagePath', 'mimeType', 'sizeBytes', 'createdAt'
      ])
      && data.keys().hasOnly([
        'wallpaperId', 'userId', 'name', 'imageUrl',
        'storagePath', 'mimeType', 'sizeBytes', 'createdAt'
      ])
      && isValidId(data.wallpaperId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 800000
      && data.storagePath is string && data.storagePath.size() <= 500
      && data.mimeType is string && data.mimeType.size() <= 40
      && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 10485760
      && data.createdAt is timestamp;
    }

    function isValidUserMembership(data) {
      return data.keys().hasAll(['userId', 'chatId', 'role', 'isPinned', 'isMuted', 'joinedAt', 'updatedAt'])
      && data.keys().hasOnly(['userId', 'chatId', 'role', 'isPinned', 'isMuted', 'joinedAt', 'updatedAt'])
      && isValidId(data.userId)
      && isValidId(data.chatId)
      && data.role is string && data.role.size() <= 20 && data.role in ['owner', 'admin', 'moderator', 'member']
      && data.isPinned is bool
      && data.isMuted is bool
      && data.joinedAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidChat(data) {
      return data.keys().hasAll([
        'chatId', 'type', 'visibility', 'name', 'description', 'avatarUrl',
        'ownerId', 'peerUserId', 'membersCount',
        'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'chatId', 'type', 'visibility', 'name', 'description', 'avatarUrl',
        'ownerId', 'peerUserId', 'membersCount',
        'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.chatId)
      && data.type is string && data.type.size() <= 20 && data.type in ['direct', 'group', 'channel']
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
      && data.description is string && data.description.size() <= 500
      && data.avatarUrl is string && data.avatarUrl.size() <= 2000
      && isValidId(data.ownerId)
      && isValidId(data.peerUserId)
      && data.membersCount is int && data.membersCount >= 1
      && data.lastMessageText is string && data.lastMessageText.size() <= 500
      && data.lastMessageType is string && data.lastMessageType.size() <= 20 && data.lastMessageType in ['text', 'image', 'video', 'voice', 'video_circle']
      && isValidId(data.lastMessageSenderId)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidChatMember(data) {
      return data.keys().hasAll(['chatId', 'userId', 'role', 'displayName', 'avatarUrl', 'joinedAt'])
      && data.keys().hasOnly(['chatId', 'userId', 'role', 'displayName', 'avatarUrl', 'joinedAt'])
      && isValidId(data.chatId)
      && isValidId(data.userId)
      && data.role is string && data.role.size() <= 20 && data.role in ['owner', 'admin', 'moderator', 'member']
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.avatarUrl is string && data.avatarUrl.size() <= 2000
      && data.joinedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
        'messageId', 'chatId', 'senderId', 'senderName', 'senderAvatar',
        'recipientId', 'chatVisibility', 'type', 'content', 'mediaUrl',
        'duration', 'status', 'likesCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'messageId', 'chatId', 'senderId', 'senderName', 'senderAvatar',
        'recipientId', 'chatVisibility', 'type', 'content', 'mediaUrl',
        'duration', 'status', 'likesCount', 'reactionEmoji',
        'replyToId', 'replyToSender', 'replyToText', 'forwardedFromName',
        'deletedForUserIds', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.messageId)
      && isValidId(data.chatId)
      && isValidId(data.senderId)
      && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
      && data.senderAvatar is string && data.senderAvatar.size() <= 2000
      && isValidId(data.recipientId)
      && data.chatVisibility is string && data.chatVisibility.size() <= 20 && data.chatVisibility in ['public', 'private']
      && data.type is string && data.type.size() <= 20 && data.type in ['text', 'image', 'video', 'voice', 'video_circle']
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
      && data.mediaUrl is string && data.mediaUrl.size() <= 800000
      && data.duration is int && data.duration >= 0 && data.duration <= 3600
      && data.status is string && data.status.size() <= 20 && data.status in ['sent', 'delivered', 'read']
      && data.likesCount is int && data.likesCount >= 0
      && (!('reactionEmoji' in data) || (data.reactionEmoji is string && data.reactionEmoji.size() <= 16))
      && (!('replyToId' in data) || (data.replyToId is string && data.replyToId.size() <= 128))
      && (!('replyToSender' in data) || (data.replyToSender is string && data.replyToSender.size() <= 80))
      && (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 500))
      && (!('forwardedFromName' in data) || (data.forwardedFromName is string && data.forwardedFromName.size() <= 80))
      && (!('deletedForUserIds' in data) || (data.deletedForUserIds is list && data.deletedForUserIds.size() <= 100))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
        'postId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'visibility', 'content', 'mediaUrl', 'mediaType',
        'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'postId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'visibility', 'content', 'mediaUrl', 'mediaType',
        'mediaItems', 'mediaLayout',
        'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.postId)
      && isValidId(data.authorId)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 40
      && data.authorAvatar is string && data.authorAvatar.size() <= 2000
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 3000
      && data.mediaUrl is string && data.mediaUrl.size() <= 900000
      && data.mediaType is string && data.mediaType.size() <= 20 && data.mediaType in ['none', 'image', 'video']
      && (!('mediaItems' in data) || (data.mediaItems is list && data.mediaItems.size() <= 9))
      && (!('mediaLayout' in data) || (data.mediaLayout is string && data.mediaLayout in ['carousel', 'grid']))
      && data.likesCount is int && data.likesCount >= 0
      && data.commentsCount is int && data.commentsCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPostLike(data) {
      return data.keys().hasAll(['postId', 'userId', 'createdAt'])
      && data.keys().hasOnly(['postId', 'userId', 'createdAt'])
      && isValidId(data.postId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.createdAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll([
        'commentId', 'postId', 'authorId', 'authorName', 'authorAvatar',
        'postVisibility', 'content', 'createdAt'
      ])
      && data.keys().hasOnly([
        'commentId', 'postId', 'authorId', 'authorName', 'authorAvatar',
        'postVisibility', 'content', 'createdAt'
      ])
      && isValidId(data.commentId)
      && isValidId(data.postId)
      && isValidId(data.authorId)
      && isOwner(data.authorId)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.authorAvatar is string && data.authorAvatar.size() <= 2000
      && data.postVisibility is string && data.postVisibility.size() <= 20 && data.postVisibility in ['public', 'private']
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
      && data.createdAt is timestamp;
    }

    function isValidCallSession(data) {
      return data.keys().hasAll([
        'callId', 'chatId', 'callerId', 'callerName', 'callerAvatar',
        'calleeId', 'type', 'status', 'isScreenSharing',
        'offerSdp', 'offerType', 'answerSdp', 'answerType',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'callId', 'chatId', 'callerId', 'callerName', 'callerAvatar',
        'calleeId', 'type', 'status', 'isScreenSharing',
        'callerVideoEnabled', 'calleeVideoEnabled',
        'callerAudioMuted', 'calleeAudioMuted',
        'callerScreenSharing', 'calleeScreenSharing',
        'offerSenderId', 'screenShareSurface',
        'offerSdp', 'offerType', 'answerSdp', 'answerType',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.callId)
      && isValidId(data.chatId)
      && isValidId(data.callerId)
      && data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 80
      && data.callerAvatar is string && data.callerAvatar.size() <= 2000
      && isValidId(data.calleeId)
      && data.type is string && data.type.size() <= 20 && data.type in ['audio', 'video']
      && data.status is string && data.status.size() <= 20 && data.status in ['ringing', 'connected', 'ended']
      && data.isScreenSharing is bool
      && (!('callerVideoEnabled' in data) || data.callerVideoEnabled is bool)
      && (!('calleeVideoEnabled' in data) || data.calleeVideoEnabled is bool)
      && (!('callerAudioMuted' in data) || data.callerAudioMuted is bool)
      && (!('calleeAudioMuted' in data) || data.calleeAudioMuted is bool)
      && (!('callerScreenSharing' in data) || data.callerScreenSharing is bool)
      && (!('calleeScreenSharing' in data) || data.calleeScreenSharing is bool)
      && (!('offerSenderId' in data) || isValidId(data.offerSenderId))
      && (!('screenShareSurface' in data) || (data.screenShareSurface is string && data.screenShareSurface.size() <= 20 && data.screenShareSurface in ['monitor', 'window', 'browser']))
      && data.offerSdp is string && data.offerSdp.size() <= 30000
      && data.offerType is string && data.offerType.size() <= 20
      && data.answerSdp is string && data.answerSdp.size() <= 30000
      && data.answerType is string && data.answerType.size() <= 20
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidIceCandidate(data) {
      return data.keys().hasAll([
        'candidateId', 'callId', 'senderId', 'recipientId',
        'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'
      ])
      && data.keys().hasOnly([
        'candidateId', 'callId', 'senderId', 'recipientId',
        'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'
      ])
      && isValidId(data.candidateId)
      && isValidId(data.callId)
      && isValidId(data.senderId)
      && isOwner(data.senderId)
      && isValidId(data.recipientId)
      && data.candidate is string && data.candidate.size() >= 1 && data.candidate.size() <= 2000
      && data.sdpMid is string && data.sdpMid.size() <= 64
      && data.sdpMLineIndex is int && data.sdpMLineIndex >= 0
      && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        'reportId', 'reporterId', 'targetId', 'targetType',
        'reason', 'status', 'createdAt'
      ])
      && data.keys().hasOnly([
        'reportId', 'reporterId', 'targetId', 'targetType',
        'reason', 'status', 'createdAt'
      ])
      && isValidId(data.reportId)
      && isValidId(data.reporterId)
      && isOwner(data.reporterId)
      && isValidId(data.targetId)
      && data.targetType is string && data.targetType.size() <= 20 && data.targetType in ['user', 'chat', 'post', 'message', 'video', 'video_comment']
      && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 1000
      && data.status is string && data.status.size() <= 20 && data.status in ['open', 'resolved']
      && data.createdAt is timestamp;
    }

    function isValidUserSession(data) {
      return data.keys().hasAll([
        'sessionId', 'userId', 'device', 'ip', 'status'
      ])
      && data.keys().hasOnly([
        'sessionId', 'userId', 'device', 'ip', 'status',
        'isCurrent', 'lastActiveAt', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.sessionId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.device is string && data.device.size() >= 1 && data.device.size() <= 200
      && data.ip is string && data.ip.size() >= 1 && data.ip.size() <= 64
      && data.status is string && data.status.size() <= 20 && data.status in ['active', 'terminated']
      && (!('isCurrent' in data) || data.isCurrent is bool)
      && (!('lastActiveAt' in data) || data.lastActiveAt is timestamp)
      && (!('createdAt' in data) || data.createdAt is timestamp)
      && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMenderVideo(data) {
      return data.keys().hasAll([
        'videoId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'title', 'description', 'category', 'hashtags',
        'videoUrl', 'thumbnailUrl', 'duration', 'sizeBytes', 'mimeType',
        'status', 'visibility', 'viewsCount', 'likesCount', 'commentsCount',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'videoId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'title', 'description', 'category', 'hashtags',
        'videoUrl', 'thumbnailUrl', 'duration', 'sizeBytes', 'mimeType',
        'status', 'visibility', 'viewsCount', 'likesCount', 'commentsCount',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.videoId)
      && isValidId(data.authorId)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40
      && data.authorAvatar is string && data.authorAvatar.size() <= 2000
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.description is string && data.description.size() <= 5000
      && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
      && data.hashtags is list && data.hashtags.size() <= 25
      && data.videoUrl is string && data.videoUrl.size() >= 5 && data.videoUrl.size() <= 2000000
      && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000000
      && (data.duration is int || data.duration is float) && data.duration >= 0
      && data.sizeBytes is int && data.sizeBytes >= 0
      && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 64
      && data.status is string && data.status.size() <= 20 && data.status in ['published', 'draft']
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.viewsCount is int && data.viewsCount >= 0
      && data.likesCount is int && data.likesCount >= 0
      && data.commentsCount is int && data.commentsCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMenderVideoView(data) {
      return data.keys().hasAll(['videoId', 'viewerId', 'createdAt'])
      && data.keys().hasOnly(['videoId', 'viewerId', 'createdAt'])
      && isValidId(data.videoId)
      && isValidId(data.viewerId)
      && isOwner(data.viewerId)
      && data.createdAt is timestamp;
    }

    function isValidMenderVideoLike(data) {
      return data.keys().hasAll(['videoId', 'userId', 'createdAt'])
      && data.keys().hasOnly(['videoId', 'userId', 'createdAt'])
      && isValidId(data.videoId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.createdAt is timestamp;
    }

    function isValidMenderVideoComment(data) {
      return data.keys().hasAll([
        'commentId', 'videoId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'content', 'parentCommentId', 'replyToAuthorName',
        'likesCount', 'likedByUserIds', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'commentId', 'videoId', 'authorId', 'authorName', 'authorUsername', 'authorAvatar',
        'content', 'parentCommentId', 'replyToAuthorName',
        'likesCount', 'likedByUserIds', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.commentId)
      && isValidId(data.videoId)
      && isValidId(data.authorId)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40
      && data.authorAvatar is string && data.authorAvatar.size() <= 2000
      && data.parentCommentId is string && data.parentCommentId.size() <= 128
      && data.replyToAuthorName is string && data.replyToAuthorName.size() <= 120
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
      && data.likesCount is int && data.likesCount >= 0
      && data.likedByUserIds is list && data.likedByUserIds.size() <= 2000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidVideoPlaylist(data) {
      return data.keys().hasAll([
        'playlistId', 'ownerId', 'ownerName', 'ownerUsername', 'ownerAvatar',
        'title', 'description', 'visibility',
        'videoIds', 'coverUrl', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'playlistId', 'ownerId', 'ownerName', 'ownerUsername', 'ownerAvatar',
        'title', 'description', 'visibility',
        'videoIds', 'coverUrl', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.playlistId)
      && isValidId(data.ownerId)
      && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
      && data.ownerUsername is string && data.ownerUsername.size() >= 1 && data.ownerUsername.size() <= 40
      && data.ownerAvatar is string && data.ownerAvatar.size() <= 2000
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && data.description is string && data.description.size() <= 1000
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.videoIds is list && data.videoIds.size() <= 500
      && data.coverUrl is string && data.coverUrl.size() <= 1000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidVideoNotification(data) {
      return data.keys().hasAll([
        'notificationId', 'recipientId', 'actorId', 'actorName', 'actorUsername', 'actorAvatar',
        'type', 'videoId', 'videoTitle', 'commentText', 'isRead', 'createdAt'
      ])
      && data.keys().hasOnly([
        'notificationId', 'recipientId', 'actorId', 'actorName', 'actorUsername', 'actorAvatar',
        'type', 'videoId', 'videoTitle', 'commentText', 'isRead', 'createdAt'
      ])
      && isValidId(data.notificationId)
      && isValidId(data.recipientId)
      && isValidId(data.actorId)
      && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
      && data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 40
      && data.actorAvatar is string && data.actorAvatar.size() <= 2000
      && data.type is string && data.type.size() <= 32 && data.type in [
        'new_subscriber', 'video_like', 'new_comment', 'comment_reply', 'comment_like'
      ]
      && data.videoId is string && data.videoId.size() <= 128
      && data.videoTitle is string && data.videoTitle.size() <= 200
      && data.commentText is string && data.commentText.size() <= 500
      && data.isRead is bool
      && data.createdAt is timestamp;
    }

    function isValidMenderMusicTrack(data) {
      return data.keys().hasAll([
        'trackId', 'uploaderId', 'uploaderName', 'uploaderUsername', 'uploaderAvatar',
        'title', 'artist', 'artistId', 'albumTitle', 'albumId', 'genre', 'releaseYear',
        'audioUrl', 'coverUrl', 'duration', 'sizeBytes', 'mimeType',
        'visibility', 'playsCount', 'likesCount', 'lyrics', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'trackId', 'uploaderId', 'uploaderName', 'uploaderUsername', 'uploaderAvatar',
        'title', 'artist', 'artistId', 'albumTitle', 'albumId', 'genre', 'releaseYear',
        'audioUrl', 'coverUrl', 'duration', 'sizeBytes', 'mimeType',
        'visibility', 'playsCount', 'likesCount', 'lyrics', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.trackId)
      && isValidId(data.uploaderId)
      && data.uploaderName is string && data.uploaderName.size() >= 1 && data.uploaderName.size() <= 80
      && data.uploaderUsername is string && data.uploaderUsername.size() >= 1 && data.uploaderUsername.size() <= 40
      && data.uploaderAvatar is string && data.uploaderAvatar.size() <= 2000
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 100
      && data.artistId is string && data.artistId.size() >= 1 && data.artistId.size() <= 128
      && data.albumTitle is string && data.albumTitle.size() >= 1 && data.albumTitle.size() <= 120
      && data.albumId is string && data.albumId.size() >= 1 && data.albumId.size() <= 128
      && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 60
      && data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100
      && data.audioUrl is string && data.audioUrl.size() >= 1 && data.audioUrl.size() <= 2000000
      && data.coverUrl is string && data.coverUrl.size() <= 1000000
      && (data.duration is int || data.duration is float) && data.duration >= 0
      && data.sizeBytes is int && data.sizeBytes >= 0
      && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 64
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.playsCount is int && data.playsCount >= 0
      && data.likesCount is int && data.likesCount >= 0
      && data.lyrics is string && data.lyrics.size() <= 5000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMenderMusicLike(data) {
      return data.keys().hasAll(['trackId', 'userId', 'createdAt'])
      && data.keys().hasOnly(['trackId', 'userId', 'createdAt'])
      && isValidId(data.trackId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.createdAt is timestamp;
    }

    function isValidMenderMusicPlaylist(data) {
      return data.keys().hasAll([
        'playlistId', 'ownerId', 'ownerName', 'ownerUsername', 'ownerAvatar',
        'title', 'description', 'visibility', 'trackIds', 'coverUrl', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'playlistId', 'ownerId', 'ownerName', 'ownerUsername', 'ownerAvatar',
        'title', 'description', 'visibility', 'trackIds', 'coverUrl', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.playlistId)
      && isValidId(data.ownerId)
      && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
      && data.ownerUsername is string && data.ownerUsername.size() >= 1 && data.ownerUsername.size() <= 40
      && data.ownerAvatar is string && data.ownerAvatar.size() <= 2000
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.description is string && data.description.size() <= 1000
      && data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private']
      && data.trackIds is list && data.trackIds.size() <= 500
      && data.coverUrl is string && data.coverUrl.size() <= 1000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidProfileFolder(data) {
      return data.keys().hasAll(['folderId', 'userId', 'name', 'postIds'])
      && data.keys().hasOnly(['folderId', 'userId', 'name', 'icon', 'postIds', 'createdAt', 'updatedAt'])
      && isValidId(data.folderId)
      && isValidId(data.userId)
      && isOwner(data.userId)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
      && (!('icon' in data) || (data.icon is string && data.icon.size() <= 40))
      && data.postIds is list && data.postIds.size() <= 500
      && (!('createdAt' in data) || data.createdAt is timestamp)
      && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // =========================================================================
    // 3. COLLECTION RULES
    // =========================================================================

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().status in ['online', 'offline', 'busy'];

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == userId
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'avatarUrl', 'bio', 'status',
              'privacyLastSeen', 'privacyPhoto', 'privacyCalls', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt'])
          ))
          ||
          (
            userId != request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && (
              incoming().followersCount == existing().followersCount + 1
              || incoming().followersCount == existing().followersCount - 1
            )
          )
        );

      allow delete: if false;

      match /subscriptions/{targetId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(targetId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().subscriberId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(targetId)
          && isOwner(userId)
          && isValidSubscription(incoming())
          && incoming().subscriberId == userId
          && incoming().targetId == targetId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(targetId)
          && isOwner(userId)
          && isOwner(existing().subscriberId);
      }

      match /memberships/{chatId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(chatId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(chatId)
          && isValidUserMembership(incoming())
          && incoming().userId == userId
          && incoming().chatId == chatId
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId) && (
              (existsAfter(/databases/$(database)/documents/chats/$(chatId))
                && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
                && incoming().role == 'owner')
              ||
              (exists(/databases/$(database)/documents/chats/$(chatId))
                && get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'public'
                && incoming().role == 'member')
              ||
              (exists(/databases/$(database)/documents/chats/$(chatId)/members/$(userId))
                && incoming().role == get(/databases/$(database)/documents/chats/$(chatId)/members/$(userId)).data.role)
            ))
            ||
            (existsAfter(/databases/$(database)/documents/chats/$(chatId))
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
              && incoming().role in ['admin', 'moderator', 'member'])
            ||
            (exists(/databases/$(database)/documents/chats/$(chatId))
              && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
              && incoming().role in ['admin', 'moderator', 'member'])
          );

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(chatId)
          && isValidUserMembership(incoming())
          && incoming().userId == existing().userId
          && incoming().chatId == existing().chatId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['isPinned', 'isMuted', 'updatedAt']))
            ||
            (
              exists(/databases/$(database)/documents/chats/$(chatId))
              && isChatAdmin(chatId)
              && incoming().role in ['admin', 'moderator', 'member']
              && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
            )
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(chatId)
          && isOwner(userId)
          && isOwner(existing().userId);
      }

      match /wallpaper_configs/{scopeId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(scopeId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(scopeId)
          && isOwner(userId)
          && isValidWallpaperConfig(incoming())
          && incoming().userId == userId
          && incoming().scopeId == scopeId
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(scopeId)
          && isOwner(userId)
          && isValidWallpaperConfig(incoming())
          && incoming().userId == existing().userId
          && incoming().scopeId == existing().scopeId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'wallpaperId', 'sourceType', 'imageUrl', 'backgroundColor',
            'dimming', 'brightness', 'blur', 'scale', 'posX', 'posY', 'updatedAt'
          ]);

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(scopeId)
          && isOwner(userId)
          && isOwner(existing().userId);
      }

      match /custom_wallpapers/{wallpaperId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(wallpaperId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(wallpaperId)
          && isOwner(userId)
          && isValidCustomWallpaper(incoming())
          && incoming().userId == userId
          && incoming().wallpaperId == wallpaperId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(wallpaperId)
          && isOwner(userId)
          && isOwner(existing().userId);
      }

      match /profile_folders/{folderId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(folderId);
        allow list: if isSignedIn() && existing().userId == userId;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(folderId)
          && isOwner(userId)
          && isValidProfileFolder(incoming())
          && incoming().folderId == folderId
          && incoming().userId == userId;
        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(folderId)
          && isOwner(userId)
          && isValidProfileFolder(incoming())
          && incoming().folderId == existing().folderId
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'postIds', 'updatedAt']);
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(folderId)
          && isOwner(userId);
      }

      match /activeSessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidUserSession(incoming())
          && incoming().sessionId == sessionId
          && incoming().userId == userId;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidUserSession(incoming())
          && incoming().sessionId == existing().sessionId
          && incoming().userId == existing().userId
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'device', 'ip', 'status', 'lastActiveAt', 'createdAt', 'updatedAt'
            ])
            ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ])
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId);
      }

      match /video_notifications/{notificationId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().recipientId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidVideoNotification(incoming())
          && incoming().notificationId == notificationId
          && incoming().recipientId == userId
          && isOwner(incoming().actorId)
          && incoming().isRead == false
          && incoming().createdAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(notificationId)
          && isOwner(userId)
          && isValidVideoNotification(incoming())
          && incoming().notificationId == existing().notificationId
          && incoming().recipientId == existing().recipientId
          && incoming().actorId == existing().actorId
          && incoming().type == existing().type
          && incoming().videoId == existing().videoId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(notificationId)
          && isOwner(userId)
          && isOwner(existing().recipientId);
      }
    }

    match /users_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pinHash', 'pinSalt', 'passwordHash', 'passwordSalt', 'twoFactorEnabled', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'darkMode', 'notificationsEnabled', 'soundEnabled', 'updatedAt'
          ])
        );

      allow delete: if false;

      match /blocks/{blockedUserId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(blockedUserId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && isOwner(existing().blockerId);

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(blockedUserId)
          && isOwner(userId)
          && isValidUserBlock(incoming())
          && incoming().blockerId == userId
          && incoming().blockedUserId == blockedUserId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users_private/$(userId));

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(blockedUserId)
          && isOwner(userId)
          && isOwner(existing().blockerId);
      }
    }

    match /chats/{chatId} {
      allow get: if isSignedIn()
        && isValidId(chatId)
        && (
          resource == null
          || existing().visibility == 'public'
          || isOwner(existing().ownerId)
          || isOwner(existing().peerUserId)
          || isChatMember(chatId)
        );

      allow list: if isSignedIn()
        && (
          existing().visibility == 'public'
          || isOwner(existing().ownerId)
          || isOwner(existing().peerUserId)
        );

      allow create: if isVerified()
        && isValidId(chatId)
        && isValidChat(incoming())
        && incoming().chatId == chatId
        && isOwner(incoming().ownerId)
        && (isOwner(incoming().lastMessageSenderId) || incoming().lastMessageSenderId == 'mender_security_bot')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(chatId)
        && isValidChat(incoming())
        && incoming().chatId == existing().chatId
        && incoming().type == existing().type
        && incoming().ownerId == existing().ownerId
        && incoming().peerUserId == existing().peerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isChatAdmin(chatId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'avatarUrl', 'visibility', 'membersCount', 'updatedAt'
          ]))
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageType', 'lastMessageSenderId', 'membersCount', 'updatedAt'
            ])
            && (
              (
                (
                  isOwner(existing().ownerId)
                  || (existing().type != 'channel' && (isOwner(existing().peerUserId) || isChatMember(chatId)))
                  || isChatAdmin(chatId)
                )
                && (isOwner(incoming().lastMessageSenderId) || isChatAdmin(chatId))
              )
              ||
              (
                existing().visibility == 'public'
                && (
                  incoming().membersCount == existing().membersCount + 1
                  || incoming().membersCount == existing().membersCount - 1
                )
                && incoming().lastMessageText == existing().lastMessageText
                && incoming().lastMessageType == existing().lastMessageType
                && isOwner(incoming().lastMessageSenderId)
              )
            )
          )
        );

      allow delete: if isVerified()
        && isValidId(chatId)
        && isOwner(existing().ownerId);

      match /members/{memberId} {
        allow get: if isSignedIn()
          && isValidId(chatId)
          && isValidId(memberId)
          && (
            isOwner(memberId)
            || get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.peerUserId == request.auth.uid
            || isChatMember(chatId)
          );

        allow list: if isSignedIn()
          && existing().chatId == chatId
          && existing().role in ['owner', 'admin', 'moderator', 'member'];

        allow create: if isVerified()
          && isValidId(chatId)
          && isValidId(memberId)
          && isValidChatMember(incoming())
          && incoming().chatId == chatId
          && incoming().userId == memberId
          && incoming().joinedAt == request.time
          && (
            (
              existsAfter(/databases/$(database)/documents/chats/$(chatId))
              && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
              && (
                (isOwner(memberId) && incoming().role == 'owner')
                || incoming().role in ['admin', 'moderator', 'member']
              )
            )
            ||
            (
              exists(/databases/$(database)/documents/chats/$(chatId))
              && isChatAdmin(chatId)
              && incoming().role in ['admin', 'moderator', 'member']
            )
            ||
            (
              exists(/databases/$(database)/documents/chats/$(chatId))
              && get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'public'
              && isOwner(memberId)
              && incoming().role == 'member'
            )
          );

        allow update: if isVerified()
          && isValidId(chatId)
          && isValidId(memberId)
          && isValidChatMember(incoming())
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && isChatAdmin(chatId)
          && existing().role != 'owner'
          && incoming().chatId == existing().chatId
          && incoming().userId == existing().userId
          && incoming().joinedAt == existing().joinedAt
          && incoming().role in ['admin', 'moderator', 'member']
          && incoming().diff(existing()).affectedKeys().hasOnly(['role']);

        allow delete: if isVerified()
          && isValidId(chatId)
          && isValidId(memberId)
          && (
            isOwner(memberId)
            || (exists(/databases/$(database)/documents/chats/$(chatId)) && isChatAdmin(chatId) && existing().role != 'owner')
          );
      }

      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && (
            existing().chatVisibility == 'public'
            || isOwner(existing().senderId)
            || isOwner(existing().recipientId)
            || isChatMember(chatId)
          );

        allow list: if isSignedIn()
          && existing().chatId == chatId
          && (
            existing().chatVisibility == 'public'
            || isOwner(existing().senderId)
            || isOwner(existing().recipientId)
          );

        allow create: if isVerified()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().messageId == messageId
          && incoming().chatId == chatId
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && incoming().chatVisibility == get(/databases/$(database)/documents/chats/$(chatId)).data.visibility
          && (
            (
              isOwner(incoming().senderId)
              && (
                (
                  get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel'
                  && isChatAdmin(chatId)
                )
                ||
                (
                  get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel'
                  && (
                    get(/databases/$(database)/documents/chats/$(chatId)).data.visibility == 'public'
                    || get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
                    || get(/databases/$(database)/documents/chats/$(chatId)).data.peerUserId == request.auth.uid
                    || isChatMember(chatId)
                  )
                )
              )
            )
            ||
            (
              incoming().senderId == 'mender_security_bot'
              && isOwner(incoming().recipientId)
              && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
            )
          )
          && incoming().likesCount == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().messageId == existing().messageId
          && incoming().chatId == existing().chatId
          && incoming().senderId == existing().senderId
          && incoming().recipientId == existing().recipientId
          && incoming().type == existing().type
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              isOwner(existing().senderId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])
            )
            ||
            (
              (
                existing().chatVisibility == 'public'
                || isOwner(existing().senderId)
                || isOwner(existing().recipientId)
                || isChatMember(chatId)
              )
              && (
                (
                  incoming().diff(existing()).affectedKeys().hasOnly(['status', 'likesCount', 'reactionEmoji', 'updatedAt'])
                  && (
                    incoming().likesCount == existing().likesCount
                    || incoming().likesCount == existing().likesCount + 1
                    || incoming().likesCount == existing().likesCount - 1
                  )
                )
                ||
                incoming().diff(existing()).affectedKeys().hasOnly(['deletedForUserIds', 'updatedAt'])
              )
            )
          );

        allow delete: if isVerified()
          && isValidId(chatId)
          && isValidId(messageId)
          && (
            isOwner(existing().senderId)
            || isOwner(existing().recipientId)
            || (exists(/databases/$(database)/documents/chats/$(chatId)) && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid)
          );
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn()
        && isValidId(postId)
        && (existing().visibility == 'public' || isOwner(existing().authorId));

      allow list: if isSignedIn()
        && (existing().visibility == 'public' || isOwner(existing().authorId));

      allow create: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().postId == postId
        && isOwner(incoming().authorId)
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().postId == existing().postId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'visibility', 'updatedAt']))
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().authorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)
          )
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().authorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1)
          )
        );

      allow delete: if isVerified()
        && isValidId(postId)
        && isOwner(existing().authorId);

      match /likes/{likeUserId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(likeUserId) && isOwner(likeUserId);
        allow list: if isSignedIn() && existing().postId == postId && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(likeUserId)
          && isOwner(likeUserId)
          && isValidPostLike(incoming())
          && incoming().postId == postId
          && incoming().userId == likeUserId
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(postId)
          && isValidId(likeUserId)
          && isOwner(likeUserId);
      }

      match /comments/{commentId} {
        allow get: if isSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && (existing().postVisibility == 'public' || isOwner(existing().authorId));

        allow list: if isSignedIn()
          && existing().postId == postId
          && (existing().postVisibility == 'public' || isOwner(existing().authorId));

        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidPostComment(incoming())
          && incoming().commentId == commentId
          && incoming().postId == postId
          && isOwner(incoming().authorId)
          && incoming().createdAt == request.time;

        allow update: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isOwner(existing().authorId)
          && isValidPostComment(incoming())
          && incoming().commentId == existing().commentId
          && incoming().postId == existing().postId
          && incoming().authorId == existing().authorId
          && incoming().postVisibility == existing().postVisibility
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isOwner(existing().authorId);
      }
    }

    match /calls/{callId} {
      allow get: if isSignedIn()
        && isValidId(callId)
        && (isOwner(existing().callerId) || isOwner(existing().calleeId));

      allow list: if isSignedIn()
        && (isOwner(existing().callerId) || isOwner(existing().calleeId));

      allow create: if isVerified()
        && isValidId(callId)
        && isValidCallSession(incoming())
        && incoming().callId == callId
        && isOwner(incoming().callerId)
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(callId)
        && isValidCallSession(incoming())
        && (isOwner(existing().callerId) || isOwner(existing().calleeId))
        && existing().status != 'ended'
        && incoming().callId == existing().callId
        && incoming().chatId == existing().chatId
        && incoming().callerId == existing().callerId
        && incoming().calleeId == existing().calleeId
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'isScreenSharing', 'callerVideoEnabled', 'calleeVideoEnabled',
          'callerAudioMuted', 'calleeAudioMuted',
          'callerScreenSharing', 'calleeScreenSharing', 'offerSenderId',
          'screenShareSurface', 'offerSdp', 'offerType', 'answerSdp', 'answerType', 'updatedAt'
        ]);

      allow delete: if false;

      match /candidates/{candidateId} {
        allow get: if isSignedIn()
          && isValidId(callId)
          && isValidId(candidateId)
          && (isOwner(existing().senderId) || isOwner(existing().recipientId));

        allow list: if isSignedIn()
          && existing().callId == callId
          && (isOwner(existing().senderId) || isOwner(existing().recipientId));

        allow create: if isVerified()
          && isValidId(callId)
          && isValidId(candidateId)
          && isValidIceCandidate(incoming())
          && exists(/databases/$(database)/documents/calls/$(callId))
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          )
          && incoming().candidateId == candidateId
          && incoming().callId == callId
          && isOwner(incoming().senderId)
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow get: if isSignedIn()
        && isValidId(reportId)
        && isOwner(existing().reporterId);

      allow list: if isSignedIn()
        && isOwner(existing().reporterId);

      allow create: if isVerified()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reportId == reportId
        && isOwner(incoming().reporterId)
        && incoming().status == 'open'
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    match /mender_videos/{videoId} {
      allow get: if isSignedIn()
        && isValidId(videoId)
        && (existing().visibility == 'public' || isOwner(existing().authorId));

      allow list: if isSignedIn()
        && (existing().visibility == 'public' || isOwner(existing().authorId));

      allow create: if isVerified()
        && isValidId(videoId)
        && isValidMenderVideo(incoming())
        && incoming().videoId == videoId
        && isOwner(incoming().authorId)
        && incoming().viewsCount == 0
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(videoId)
        && isValidMenderVideo(incoming())
        && incoming().videoId == existing().videoId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category', 'hashtags', 'videoUrl',
            'thumbnailUrl', 'duration', 'sizeBytes', 'mimeType',
            'status', 'visibility', 'updatedAt'
          ]))
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().authorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt'])
            && incoming().viewsCount == existing().viewsCount + 1
          )
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().authorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)
          )
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().authorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1)
          )
        );

      allow delete: if isVerified()
        && isValidId(videoId)
        && isOwner(existing().authorId);

      match /views/{viewerId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(viewerId) && isOwner(viewerId);
        allow list: if isSignedIn() && existing().videoId == videoId && isOwner(existing().viewerId);

        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && isValidMenderVideoView(incoming())
          && incoming().videoId == videoId
          && incoming().viewerId == viewerId
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }

      match /likes/{likeUserId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(likeUserId) && isOwner(likeUserId);
        allow list: if isSignedIn() && existing().videoId == videoId && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(likeUserId)
          && isOwner(likeUserId)
          && isValidMenderVideoLike(incoming())
          && incoming().videoId == videoId
          && incoming().userId == likeUserId
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(videoId)
          && isValidId(likeUserId)
          && isOwner(likeUserId);
      }

      match /comments/{commentId} {
        allow get: if isSignedIn()
          && isValidId(videoId)
          && isValidId(commentId)
          && existing().videoId == videoId
          && (
            get(/databases/$(database)/documents/mender_videos/$(videoId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/mender_videos/$(videoId)).data.authorId == request.auth.uid
          );

        allow list: if isSignedIn()
          && existing().videoId == videoId;

        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidMenderVideoComment(incoming())
          && exists(/databases/$(database)/documents/mender_videos/$(videoId))
          && incoming().commentId == commentId
          && incoming().videoId == videoId
          && isOwner(incoming().authorId)
          && incoming().likesCount == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidMenderVideoComment(incoming())
          && incoming().commentId == existing().commentId
          && incoming().videoId == existing().videoId
          && incoming().authorId == existing().authorId
          && incoming().parentCommentId == existing().parentCommentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'likedByUserIds', 'updatedAt'])
          && (
            incoming().likesCount == existing().likesCount + 1
            || incoming().likesCount == existing().likesCount - 1
          );

        allow delete: if isVerified()
          && isValidId(videoId)
          && isValidId(commentId)
          && (
            isOwner(existing().authorId)
            || get(/databases/$(database)/documents/mender_videos/$(videoId)).data.authorId == request.auth.uid
          );
      }
    }

    match /video_playlists/{playlistId} {
      allow get: if isSignedIn()
        && isValidId(playlistId)
        && (existing().visibility == 'public' || isOwner(existing().ownerId));

      allow list: if isSignedIn()
        && (existing().visibility == 'public' || isOwner(existing().ownerId));

      allow create: if isVerified()
        && isValidId(playlistId)
        && isValidVideoPlaylist(incoming())
        && incoming().playlistId == playlistId
        && isOwner(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(playlistId)
        && isOwner(existing().ownerId)
        && isValidVideoPlaylist(incoming())
        && incoming().playlistId == existing().playlistId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'visibility', 'videoIds', 'coverUrl', 'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(playlistId)
        && isOwner(existing().ownerId);
    }

    match /mender_music_tracks/{trackId} {
      allow get: if isSignedIn()
        && isValidId(trackId)
        && (existing().visibility == 'public' || isOwner(existing().uploaderId));

      allow list: if isSignedIn()
        && (existing().visibility == 'public' || isOwner(existing().uploaderId));

      allow create: if isVerified()
        && isValidId(trackId)
        && isValidMenderMusicTrack(incoming())
        && incoming().trackId == trackId
        && isOwner(incoming().uploaderId)
        && incoming().playsCount == 0
        && incoming().likesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(trackId)
        && isValidMenderMusicTrack(incoming())
        && incoming().trackId == existing().trackId
        && incoming().uploaderId == existing().uploaderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(existing().uploaderId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'artist', 'artistId', 'albumTitle', 'albumId', 'genre',
            'releaseYear', 'coverUrl', 'visibility', 'lyrics', 'updatedAt'
          ]))
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().uploaderId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['playsCount', 'updatedAt'])
            && incoming().playsCount == existing().playsCount + 1
          )
          ||
          (
            (existing().visibility == 'public' || isOwner(existing().uploaderId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)
          )
        );

      allow delete: if isVerified()
        && isValidId(trackId)
        && isOwner(existing().uploaderId);

      match /likes/{likeUserId} {
        allow get: if isSignedIn() && isValidId(trackId) && isValidId(likeUserId) && isOwner(likeUserId);
        allow list: if isSignedIn() && existing().trackId == trackId && isOwner(existing().userId);

        allow create: if isVerified()
          && isValidId(trackId)
          && isValidId(likeUserId)
          && isOwner(likeUserId)
          && isValidMenderMusicLike(incoming())
          && incoming().trackId == trackId
          && incoming().userId == likeUserId
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(trackId)
          && isValidId(likeUserId)
          && isOwner(likeUserId);
      }
    }

    match /mender_music_playlists/{playlistId} {
      allow get: if isSignedIn()
        && isValidId(playlistId)
        && (existing().visibility == 'public' || isOwner(existing().ownerId));

      allow list: if isSignedIn()
        && (existing().visibility == 'public' || isOwner(existing().ownerId));

      allow create: if isVerified()
        && isValidId(playlistId)
        && isValidMenderMusicPlaylist(incoming())
        && incoming().playlistId == playlistId
        && isOwner(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(playlistId)
        && isOwner(existing().ownerId)
        && isValidMenderMusicPlaylist(incoming())
        && incoming().playlistId == existing().playlistId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'visibility', 'trackIds', 'coverUrl', 'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(playlistId)
        && isOwner(existing().ownerId);
    }
  }
}
