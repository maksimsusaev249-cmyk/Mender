{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public profile information for a Mender user (PII isolated in UserPrivate).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-zA-Z0-9_]+$" },
        "avatarUrl": { "type": "string", "maxLength": 2000 },
        "bio": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["online", "offline", "busy"] },
        "privacyLastSeen": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "privacyPhoto": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "privacyCalls": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "username",
        "avatarUrl",
        "bio",
        "status",
        "privacyLastSeen",
        "privacyPhoto",
        "privacyCalls",
        "followersCount",
        "followingCount",
        "createdAt",
        "updatedAt"
      ]
    },
