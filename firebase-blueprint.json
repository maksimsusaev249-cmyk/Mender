  "firestore": {
    "/users/{userId}": {
      "schema": "UserPublic",
      "description": "Public user profiles searchable by other users."
    },
    "/users_private/{userId}": {
      "schema": "UserPrivate",
      "description": "Private PII and hashed PIN settings accessible strictly by owner."
    },
    "/users_private/{userId}/blocks/{blockedUserId}": {
      "schema": "UserBlock",
      "description": "Subcollection of users blocked by {userId}."
    },
    "/users/{userId}/subscriptions/{targetId}": {
      "schema": "Subscription",
      "description": "Subscriptions of {userId} to other users or channels."
    },
    "/users/{userId}/memberships/{chatId}": {
      "schema": "UserMembership",
      "description": "User-specific chat membership index."
    },
    "/users/{userId}/wallpaper_configs/{scopeId}": {
      "schema": "WallpaperConfig",
      "description": "Global ('global') and per-chat ('{chatId}') wallpaper settings for {userId}."
    },
    "/users/{userId}/custom_wallpapers/{wallpaperId}": {
      "schema": "CustomWallpaper",
      "description": "Custom uploaded wallpapers owned by {userId}."
    },
    "/users/{userId}/profile_folders/{folderId}": {
      "schema": "ProfileFolder",
      "description": "User-created folders for organizing posts on their profile."
    },
    "/users/{userId}/activeSessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Active device login sessions for {userId}."
    },
    "/users/{userId}/video_notifications/{notificationId}": {
      "schema": "VideoNotification",
      "description": "Notifications for {userId} about new subscribers, video comments, replies, and likes."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Direct chats, groups, and broadcast channels."
    },
    "/chats/{chatId}/members/{memberId}": {
      "schema": "ChatMember",
      "description": "Members and their roles (owner, admin, member) inside a chat."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a chat."
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": "TypingStatus",
      "description": "Real-time typing indicator status inside a chat."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Social feed posts."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "PostLike",
      "description": "Likes on a post."
    },
